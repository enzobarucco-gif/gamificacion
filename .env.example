# ============================================================
# PGD — Variables de entorno de desarrollo local
# Copiar a .env y completar los valores reales.
# NUNCA commitear .env con valores reales.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=pgd
POSTGRES_PASSWORD=pgd
POSTGRES_DB=pgd_dev
POSTGRES_PORT=5432
DATABASE_URL="postgresql://pgd:pgd@localhost:5432/pgd_dev"

# --- Redis ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Mailhog (dev only) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025

# --- JWT ---
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# --- API ---
API_PORT=3001
API_BASE_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=debug

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Pagos (Mercado Pago) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Pagos (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Feature flags (Unleash) ---
UNLEASH_URL=
UNLEASH_API_KEY=

# --- Observabilidad ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
